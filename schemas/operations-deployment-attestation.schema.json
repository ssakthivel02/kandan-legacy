{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deployment attestation target",
  "type": "object",
  "required": ["release","baselineRelease","productionCommit","status","productionUrl","productionVerifiedAt","hashAlgorithm","criticalAssets","verifiedGitBlobs"],
  "properties": {
    "release": {"const": 251},
    "baselineRelease": {"const": 245},
    "productionCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"const": "PRODUCTION_VERIFIED"},
    "productionUrl": {"const": "https://omsaravanabhava.org/"},
    "productionVerifiedAt": {"type": "string", "format": "date-time"},
    "hashAlgorithm": {"const": "git-blob-sha1"},
    "criticalAssets": {"type": "array", "minItems": 10, "uniqueItems": true},
    "verifiedGitBlobs": {
      "type": "object",
      "minProperties": 7,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
    }
  },
  "additionalProperties": true
}
