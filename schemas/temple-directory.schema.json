{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omsaravanabhava.org/schemas/temple-directory.schema.json",
  "title": "Om Saravana Bhava Temple Directory",
  "type": "object",
  "required": [
    "release",
    "totalDiscoverableRecords",
    "tiers",
    "regionalRecordIds",
    "reviewBoundary"
  ],
  "properties": {
    "release": {
      "type": "integer",
      "minimum": 253
    },
    "totalDiscoverableRecords": {
      "const": 24
    },
    "tiers": {
      "type": "object",
      "required": [
        "publishedSourceLinkedGuides",
        "officialIdentityRecords"
      ]
    },
    "regionalRecordIds": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "reviewBoundary": {
      "type": "object",
      "required": [
        "verified",
        "notYetPublishedAsVerified"
      ]
    },
    "noPlaceholderPages": {
      "const": true
    },
    "noUnverifiedSacredClaims": {
      "const": true
    }
  },
  "additionalProperties": true
}
