{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omsaravanabhava.org/schemas/devotional-listening-path.schema.json",
  "title": "Om Saravana Bhava devotional listening paths",
  "type": "object",
  "required": ["version", "release", "privacy", "audioBoundary", "paths"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "release": {"const": "phase15"},
    "privacy": {"type": "string", "minLength": 20},
    "audioBoundary": {"type": "string", "minLength": 20},
    "paths": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "titleTa", "titleEn", "intention", "minutes", "accent", "steps"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "titleTa": {"type": "string", "minLength": 2},
          "titleEn": {"type": "string", "minLength": 2},
          "intention": {"type": "string", "minLength": 8},
          "minutes": {"type": "integer", "minimum": 3, "maximum": 30},
          "accent": {"type": "string", "pattern": "^[a-z-]+$"},
          "steps": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["type", "titleTa", "titleEn"],
              "properties": {
                "type": {"enum": ["breath", "reflect", "listen", "read"]},
                "trackId": {"type": "string"},
                "titleTa": {"type": "string"},
                "titleEn": {"type": "string"},
                "instructionTa": {"type": "string"},
                "instructionEn": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
